/*7. Write a  statement to create a table named countries including columns country_id, country_name and region_id and make sure that no countries except Italy, India and China will be entered in the table.*/
CREATE TABLE countries (
    country_id VARCHAR(10),
    country_name VARCHAR(50) CHECK (country_name IN ('Italy', 'India', 'China')),
    region_id DECIMAL(10,0)
);
